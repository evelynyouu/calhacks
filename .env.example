# Copy to .env (never commit .env)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
NESSIE_API_KEY=
NESSIE_MODE=fixture          # live = real Nessie (run python -m scripts.seed_nessie first)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
BROKER=sim                   # alpaca = send real orders (pip install alpaca-py)
ALPACA_PAPER=true            # false = real money

# Sign-in. SESSION_SECRET is required in production (without it everyone is signed out on restart).
SESSION_SECRET=              # python -c 'import secrets; print(secrets.token_urlsafe(48))'
HTTPS_ONLY=0                 # 1 in production: session cookie is Secure (HTTPS only)
TRUST_PROXY=0                # 1 behind Render's proxy, so throttling sees the real client IP
PUBLIC_BASE_URL=http://localhost:8000   # used for Google/Apple redirect URIs
AUTH_DB=                     # default data/users.db
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=             # the Services ID, e.g. com.firstfund.web
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=      # the .p8 key from Apple (or APPLE_PRIVATE_KEY with the key text)
LOGIN_ENABLED=0              # 1 = require sign-in (email + password + 2FA, Apple, Google)
